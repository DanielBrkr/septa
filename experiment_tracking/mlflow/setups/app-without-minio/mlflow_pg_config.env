# Postgres configuration
PG_USER=mlflow
PG_PASSWORD=mlflow
PG_DATABASE=mlflow
PG_PORT=5433

# From MinIO configuration
MINIO_PORT=9010

# MLflow configuration
# where the mlflow web interface should be accessible from
MLFLOW_PORT=5002
# bucket configured in minio web interface
MLFLOW_BUCKET_NAME=mlflow
# the endpoint structure: http://ContainerHostname:Port
MLFLOW_S3_ENDPOINT_URL=http://minio-standalone:${MINIO_PORT}
# don't change the "s3" prefix, that's related to the used API
ARTIFACT_DESTINATION=s3://${MLFLOW_BUCKET_NAME}

# MinIO access keys - these are needed by MLflow
# left over keys in this configuration are just an example
MINIO_ACCESS_KEY=
MINIO_SECRET_ACCESS_KEY=